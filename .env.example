# ── Режим ───────────────────────────────────────────────────────────────────
# true  = живая симуляция без внешних ключей (для демо панели)
# false = боевой режим, агенты используют реальные API ниже
DEMO_MODE=true

# Скорость demo-активности (секунд между тиками оркестратора)
TICK_SECONDS=2.5

# ── Мозги агентов (Anthropic Claude) ─────────────────────────────────────────
ANTHROPIC_API_KEY=
MODEL_WORKER=claude-sonnet-4-6     # объёмные диалоги/квалификация
MODEL_BRIEF=claude-opus-4-8        # брифы решений тебе

# ── Голос / обзвон ───────────────────────────────────────────────────────────
# EN: Vapi / Retell / Bland.  RU: локальная телефония (SIP/провайдер).
VAPI_API_KEY=
RETELL_API_KEY=
TELEPHONY_SIP_URI=

# ── Мессенджеры ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Почта ────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# ── Календарь ────────────────────────────────────────────────────────────────
GOOGLE_CALENDAR_ID=
CALCOM_API_KEY=

# ── Внешняя CRM (опционально, sync) ──────────────────────────────────────────
HUBSPOT_TOKEN=
PIPEDRIVE_TOKEN=
AMOCRM_TOKEN=
